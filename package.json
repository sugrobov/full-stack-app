{
  "name": "full-stack-app",
  "version": "1.0.0",
  "description": "Full-stack online store application",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install && cd client && npm install && cd ../server && npm install",
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "dev": "npm run start",
    "test": "echo \"No tests specified\" && exit 0",
    "prepare": "husky"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "localforage": "^1.10.0",
    "mysql2": "^3.16.0",
    "nodemailer": "^7.0.11",
    "nodemon": "^3.1.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cypress": "^15.16.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "wait-on": "^9.0.10"
  },
  "lint-staged": {
    "client/src/**/*.{js,jsx}": [
      "client/node_modules/.bin/eslint --config client/eslint.config.js --fix --max-warnings=0"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}